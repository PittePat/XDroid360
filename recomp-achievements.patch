diff -ruN a/DAORecomp/kernel/achievements.h b/DAORecomp/kernel/achievements.h
--- a/DAORecomp/kernel/achievements.h	1970-01-01 00:00:00.000000000 +0000
+++ b/DAORecomp/kernel/achievements.h	2026-11-25 01:27:48.839664749 +0000
@@ -0,0 +1,16 @@
+#pragma once
+// The game's achievements: the title reports an unlocked one through XGI, the gamer services
+// of the console's XAM (XMsgStartIORequest, app 0xFB, message 0x000B0008: XUserWriteAchievements).
+// The runtime has no screen of its own for them; a front end that wants them installs a callback
+// (the Android app: android/app/src/main/cpp/achievements_android.cpp) which is called, on the
+// game's thread, with each achievement id the game writes. Without one nothing happens.
+
+#include <cstdint>
+
+namespace dao::kernel
+{
+    using AchievementCallback = void (*)(uint32_t achievementId);
+
+    // Constant-initialised, so a front end's static initialiser may set it at any time.
+    inline AchievementCallback g_achievementCallback = nullptr;
+}
diff -ruN a/DAORecomp/kernel/xam.cpp b/DAORecomp/kernel/xam.cpp
--- a/DAORecomp/kernel/xam.cpp	2026-11-25 01:27:48.834898419 +0000
+++ b/DAORecomp/kernel/xam.cpp	2026-11-25 01:27:48.839535645 +0000
@@ -10,6 +10,7 @@
 #include "files.h"
 #include "kernel/console_config.h"
 #include "kernel/game_exit.h"
+#include "kernel/achievements.h"
 
 #include "gpu/video.h"
 #include "gpu/xenia_host.h"
@@ -1346,10 +1347,27 @@
         return X_ERROR_SUCCESS;
     }
 
+    // XGI (app 0xFB) is the title's gamer services. Message 0x000B0008 is XUserWriteAchievements:
+    // the buffer holds the number of achievements and a pointer to that many XUSER_ACHIEVEMENT
+    // {user index, achievement id}, all big-endian. The ids go to the front end's callback.
+    static void AnswerGamerServices(uint32_t app, uint32_t message, uint32_t buffer)
+    {
+        if (app != 0xFB || message != 0x000B0008 || !buffer || !g_achievementCallback)
+            return;
+        const uint32_t count = *g_memory.Translate<be<uint32_t>>(buffer);
+        const uint32_t list = *g_memory.Translate<be<uint32_t>>(buffer + 4);
+        if (!list || count == 0 || count > 64)
+            return;
+        LOGI("XUserWriteAchievements: {} achievement(s)", count);
+        for (uint32_t i = 0; i < count; i++)
+            g_achievementCallback(*g_memory.Translate<be<uint32_t>>(list + i * 8 + 4));
+    }
+
     uint32_t XMsgStartIORequest(uint32_t app, uint32_t message, uint32_t overlapped, uint32_t buffer, uint32_t length)
     {
         LOGT("XMsgStartIORequest(app {:02X}, msg {:08X}, buf {:08X}+{:#x})", app, message, buffer, length);
         AnswerMusicPlayer(app, message, buffer);
+        AnswerGamerServices(app, message, buffer);
         return Finish(overlapped, X_ERROR_SUCCESS);
     }
 
