@@ -444,6 +444,13 @@ static void SceneTilesHook(PPCContext& ctx, uint8_t* base, PPCFunc* original)
     if (ctx.r3.s32 != 2)
         return;
     const uint32_t rects = kSceneTileRects.Get();
+    // A widescreen display (DaoSceneWidthMidAsmHook): the tiles are as wide as the display.
+    const uint32_t displayWidth = dao::gpu::g_video.displayWidth;
+    if (displayWidth > 1280)
+    {
+        PPC_STORE_U32(rects + 8, displayWidth);
+        PPC_STORE_U32(rects + 24, displayWidth);
