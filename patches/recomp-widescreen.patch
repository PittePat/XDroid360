     if (dao::gpu::XeniaActive() && dao::gpu::XeniaWantsSingleSampleScene())
     {
         PPC_STORE_U32(kSceneMsaaType.Get(), 0);
@@ -457,3 +464,27 @@ static void SceneTilesHook(PPCContext& ctx, uint8_t* base, PPCFunc* original)
     }
 }
 GAME_HOOK(sub_82661640, tu6_sub_826955E8, SceneTilesHook)
+
+// Mid-asm hook placed by config/DAO.toml (0x8265E304) and config/DAO_tu6.toml (0x826922A4), in
+// the engine's display-size selection. The game ignores the width XGetVideoMode returns and
+// stores 1280x720 itself: r11 is the width and r10 the height about to be stored. With a
+// wider display mode set (SetDisplayMode, e.g. 1600x720) the width is replaced, so the
+// device and the render targets follow it.
+void DaoDisplayWidthMidAsmHook(PPCRegister& r11, PPCRegister& r10)
+{
+    const uint32_t width = dao::gpu::g_video.displayWidth;
+    if (width > 1280 && r10.u32 == 720)
+        r11.u64 = width;
+}
+
+// Mid-asm hook placed by config/DAO.toml (0x826616A0) and config/DAO_tu6.toml (0x82695648), at
+// the width compare of the scene's tile function (SceneTilesHook above): r11 is the display
+// width it just read. It only takes the HD path (2 tiles, 2xMSAA) for exactly 1280; with the
+// wider display DaoDisplayWidthMidAsmHook sets, it is told 1280, and SceneTilesHook widens
+// the tile rectangles.
+void DaoSceneWidthMidAsmHook(PPCRegister& r11)
+{
+    const uint32_t width = dao::gpu::g_video.displayWidth;
+    if (width > 1280 && r11.u32 == width)
+        r11.u64 = 1280;
+}
diff --git a/config/DAO.toml b/config/DAO.toml
index bd93b73..a6f6bd1 100644
--- a/config/DAO.toml
+++ b/config/DAO.toml
@@ -74,3 +74,21 @@ invalid_instructions = [
     { data = 0x8312A1A4, size = 8 }, # __C_specific_handler record
     { data = 0x00485645, size = 0x13C }, # data block at the end of .text (0x8312AA48-0x8312AB84)
 ]
+
+# Widescreen (experimental): sub_8265E290 picks the display size the engine builds its device
+# and render targets from: 1280x720 (or 640x480 without HD), whatever XGetVideoMode reports.
+# Both paths meet at 0x8265E304 (stw r11, 0(r29): width; r10: height). The hook replaces the
+# width when the launcher reports a wider display (gpu/video.h SetDisplayMode).
+[[midasm_hook]]
+name = "DaoDisplayWidthMidAsmHook"
+address = 0x8265E304
+registers = ["r11", "r10"]
+
+# Widescreen (experimental): the scene's tile function (sub_82661640 / its title update twin) takes
+# the 2-tile 2xMSAA HD path only for a display of exactly 1280 wide; anything else gets the 640x480
+# single tile with 4xMSAA, so the 3D scene came out as a small 4:3 picture. The hook shows the
+# function the HD width when the display is the wider mode the launcher reported.
+[[midasm_hook]]
+name = "DaoSceneWidthMidAsmHook"
+address = 0x826616A0
+registers = ["r11"]
