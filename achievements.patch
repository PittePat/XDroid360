+++ b/android/app/src/main/cpp/achievements_android.cpp	2026-11-25 01:27:49.667881756 +0000
@@ -0,0 +1,41 @@
+// Achievements (Dragon Age: Origins): the game reports an unlocked achievement to the console's
+// gamer services (XUserWriteAchievements, through XMsgStartIORequest: kernel/xam.cpp calls the
+// callback installed below, on the game's thread). The phone passes the id on to the launcher's
+// side (GameActivity.onAchievementUnlocked), which records it for the Achievements list in the
+// game's settings and shows the "Achievement unlocked" banner. The list itself, with the points
+// and the texts, is the game's own (read from its default.xex by XdbfAchievements.java).
+#include "stdafx.h"
+
+#include <jni.h>
+
+#include <SDL3/SDL_system.h>
+
+#include "kernel/achievements.h"
+
+namespace
+{
+    // One achievement unlocked, by its id in the game's list.
+    void OnUnlocked(uint32_t id)
+    {
+        auto* env = static_cast<JNIEnv*>(SDL_GetAndroidJNIEnv());
+        auto activity = static_cast<jobject>(SDL_GetAndroidActivity());
+        if (!env || !activity)
+        {
+            LOGW("Achievement {}: no activity", id);
+            return;
+        }
+        jclass cls = env->GetObjectClass(activity);
+        if (jmethodID method = env->GetMethodID(cls, "onAchievementUnlocked", "(I)V"))
+            env->CallVoidMethod(activity, method, jint(id));
+        else
+        {
+            env->ExceptionClear();
+            LOGW("Achievement {}: GameActivity.onAchievementUnlocked missing", id);
+        }
+        env->DeleteLocalRef(cls);
+        env->DeleteLocalRef(activity);
+    }
+
+    // Installed when the library loads (the callback pointer is constant-initialised).
+    const bool s_installed = (dao::kernel::g_achievementCallback = &OnUnlocked, true);
+}
diff -ruN a/android/app/src/main/java/com/udarmolota/xdroid360/AchievementToast.java b/android/app/src/main/java/com/udarmolota/xdroid360/AchievementToast.java
--- a/android/app/src/main/java/com/udarmolota/xdroid360/AchievementToast.java	1970-01-01 00:00:00.000000000 +0000
+++ b/android/app/src/main/java/com/udarmolota/xdroid360/AchievementToast.java	2026-11-25 01:27:49.673312684 +0000
@@ -0,0 +1,100 @@
+package com.udarmolota.xdroid360;
+
+import android.app.Activity;
+import android.graphics.BitmapFactory;
+import android.graphics.Color;
+import android.graphics.Typeface;
+import android.graphics.drawable.GradientDrawable;
+import android.os.Handler;
+import android.os.Looper;
+import android.view.Gravity;
+import android.view.View;
+import android.widget.FrameLayout;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import java.util.ArrayDeque;
+
+/**
+ * "Achievement unlocked" over the running game: a small banner at the top of the screen for a few
+ * seconds (touches go through to the game). Several unlocks at once show one after the other.
+ * Main thread only.
+ */
+final class AchievementToast {
+    private static final long SHOW_MS = 4500, FADE_MS = 300;
+    private static final Handler HANDLER = new Handler(Looper.getMainLooper());
+    private static final ArrayDeque<Runnable> QUEUE = new ArrayDeque<>();
+    private static boolean showing;
+
+    private AchievementToast() {}
+
+    static void show(Activity activity, XdbfAchievements.Entry entry, String language) {
+        QUEUE.add(() -> display(activity, entry, language));
+        if (!showing) next();
+    }
+
+    private static void next() {
+        Runnable r = QUEUE.poll();
+        showing = r != null;
+        if (r != null) r.run();
+    }
+
+    private static void display(Activity activity, XdbfAchievements.Entry entry, String language) {
+        if (activity.isFinishing()) {
+            QUEUE.clear();
+            showing = false;
+            return;
+        }
+        float dp = activity.getResources().getDisplayMetrics().density;
+        LinearLayout row = new LinearLayout(activity);
+        row.setOrientation(LinearLayout.HORIZONTAL);
+        row.setGravity(Gravity.CENTER_VERTICAL);
+        int pad = Math.round(10 * dp);
+        row.setPadding(pad, pad, Math.round(18 * dp), pad);
+        GradientDrawable bg = new GradientDrawable();
+        bg.setColor(0xF0202020);
+        bg.setCornerRadius(28 * dp);
+        bg.setStroke(Math.round(1.5f * dp), 0xFFB8A15C);
+        row.setBackground(bg);
+        row.setElevation(8 * dp);
+
+        ImageView icon = new ImageView(activity);
+        if (entry.icon != null) icon.setImageBitmap(BitmapFactory.decodeByteArray(entry.icon, 0, entry.icon.length));
+        int size = Math.round(48 * dp);
+        row.addView(icon, new LinearLayout.LayoutParams(size, size));
+
+        LinearLayout texts = new LinearLayout(activity);
+        texts.setOrientation(LinearLayout.VERTICAL);
+        texts.setPadding(Math.round(12 * dp), 0, 0, 0);
+        texts.addView(label(activity, activity.getString(R.string.achievement_unlocked), 11, 0xFFB8A15C, false));
+        texts.addView(label(activity, Achievements.text(entry.name, language), 16, Color.WHITE, true));
+        texts.addView(label(activity, activity.getString(R.string.achievement_points, entry.points), 12, 0xFFCCCCCC, false));
+        row.addView(texts);
+
+        FrameLayout.LayoutParams lp = new FrameLayout.LayoutParams(
+                FrameLayout.LayoutParams.WRAP_CONTENT, FrameLayout.LayoutParams.WRAP_CONTENT,
+                Gravity.TOP | Gravity.CENTER_HORIZONTAL);
+        lp.topMargin = Math.round(16 * dp);
+        row.setAlpha(0f);
+        activity.addContentView(row, lp);
+        row.animate().alpha(1f).setDuration(FADE_MS).start();
+        HANDLER.postDelayed(() -> row.animate().alpha(0f).setDuration(FADE_MS).withEndAction(() -> {
+            if (row.getParent() instanceof android.view.ViewGroup) ((android.view.ViewGroup) row.getParent()).removeView(row);
+            next();
+        }).start(), SHOW_MS);
+    }
+
+    private static TextView label(Activity activity, String text, int sp, int color, boolean bold) {
+        TextView t = new TextView(activity);
+        t.setText(text);
+        t.setTextSize(sp);
+        t.setTextColor(color);
+        t.setSingleLine(true);
+        t.setEllipsize(android.text.TextUtils.TruncateAt.END);
+        t.setMaxWidth(Math.round(240 * activity.getResources().getDisplayMetrics().density));
+        if (bold) t.setTypeface(Typeface.DEFAULT_BOLD);
+        t.setVisibility(View.VISIBLE);
+        return t;
+    }
+}
diff -ruN a/android/app/src/main/java/com/udarmolota/xdroid360/Achievements.java b/android/app/src/main/java/com/udarmolota/xdroid360/Achievements.java
--- a/android/app/src/main/java/com/udarmolota/xdroid360/Achievements.java	1970-01-01 00:00:00.000000000 +0000
+++ b/android/app/src/main/java/com/udarmolota/xdroid360/Achievements.java	2026-11-25 01:27:49.673120558 +0000
@@ -0,0 +1,126 @@
+package com.udarmolota.xdroid360;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.File;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * A game's achievements: the list the game itself defines (read from its default.xex,
+ * {@link XdbfAchievements}) and which of them the player has unlocked (userdata/achievements.json,
+ * {id: time in ms}). The game reports an unlock through GameActivity.onAchievementUnlocked.
+ */
+final class Achievements {
+    private static final Map<String, List<XdbfAchievements.Entry>> CACHE = new HashMap<>();
+
+    private Achievements() {}
+
+    /** Whether this game has achievements the launcher can show (Dragon Age: Origins). */
+    static boolean supported(Instance instance) {
+        return instance != null && instance.hasAchievements() && new File(instance.game(), "default.xex").isFile();
+    }
+
+    /** Every achievement of the game, in the game's order. Throws if the XEX can't be read. */
+    static synchronized List<XdbfAchievements.Entry> list(Instance instance) throws IOException {
+        String key = instance.root.getPath();
+        List<XdbfAchievements.Entry> cached = CACHE.get(key);
+        if (cached == null) {
+            cached = Collections.unmodifiableList(XdbfAchievements.readFromXex(new File(instance.game(), "default.xex")));
+            CACHE.put(key, cached);
+        }
+        return cached;
+    }
+
+    private static File file(Instance instance) {
+        return new File(instance.userdata(), "achievements.json");
+    }
+
+    /** The unlocked achievements: id to the time of the unlock (ms since the epoch). */
+    static synchronized Map<Integer, Long> unlocked(Instance instance) {
+        Map<Integer, Long> out = new HashMap<>();
+        try {
+            File f = file(instance);
+            if (!f.isFile()) return out;
+            JSONObject json = new JSONObject(new String(Files.readAllBytes(f.toPath()), StandardCharsets.UTF_8));
+            for (java.util.Iterator<String> it = json.keys(); it.hasNext(); ) {
+                String k = it.next();
+                out.put(Integer.parseInt(k), json.optLong(k, 0));
+            }
+        } catch (IOException | JSONException | NumberFormatException e) {
+            android.util.Log.w("XDroid360", "achievements.json: " + e);
+        }
+        return out;
+    }
+
+    /** Records an unlock; false if the achievement was unlocked before (no second notice). */
+    static synchronized boolean markUnlocked(Instance instance, int id) {
+        Map<Integer, Long> have = unlocked(instance);
+        if (have.containsKey(id)) return false;
+        have.put(id, System.currentTimeMillis());
+        try {
+            JSONObject json = new JSONObject();
+            for (Map.Entry<Integer, Long> e : have.entrySet()) json.put(String.valueOf(e.getKey()), e.getValue());
+            //noinspection ResultOfMethodCallIgnored
+            instance.userdata().mkdirs();
+            File tmp = new File(file(instance).getPath() + ".tmp");
+            Files.write(tmp.toPath(), json.toString().getBytes(StandardCharsets.UTF_8));
+            Files.move(tmp.toPath(), file(instance).toPath(), java.nio.file.StandardCopyOption.REPLACE_EXISTING);
+        } catch (IOException | JSONException e) {
+            android.util.Log.w("XDroid360", "achievements.json not written: " + e);
+        }
+        return true;
+    }
+
+    static XdbfAchievements.Entry find(List<XdbfAchievements.Entry> all, int id) {
+        for (XdbfAchievements.Entry e : all) if (e.id == id) return e;
+        return null;
+    }
+
+    /** The XDBF language code for the game's language setting (the phone's language while unset). */
+    static String languageCode(Instance instance) {
+        String l = instance.language == null ? "" : instance.language;
+        switch (l) {
+            case "english": return "en";
+            case "german": return "de";
+            case "french": return "fr";
+            case "italian": return "it";
+            case "spanish": return "es";
+            case "polish": return "pl";
+            case "russian": return "ru";
+            default: return Locale.getDefault().getLanguage();
+        }
+    }
+
+    /** A text in the language, else English, else any. */
+    static String text(Map<String, String> texts, String language) {
+        String t = texts.get(language);
+        if (t == null) t = texts.get("en");
+        if (t == null && !texts.isEmpty()) t = texts.values().iterator().next();
+        return t == null ? "" : t;
+    }
+
+    static int totalPoints(List<XdbfAchievements.Entry> all) {
+        int n = 0;
+        for (XdbfAchievements.Entry e : all) n += e.points;
+        return n;
+    }
+
+    static int earnedPoints(List<XdbfAchievements.Entry> all, Map<Integer, Long> unlocked) {
+        int n = 0;
+        for (XdbfAchievements.Entry e : all) if (unlocked.containsKey(e.id)) n += e.points;
+        return n;
+    }
+
+    static List<XdbfAchievements.Entry> copy(List<XdbfAchievements.Entry> all) {
+        return new ArrayList<>(all);
+    }
+}
